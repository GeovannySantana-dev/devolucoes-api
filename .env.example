# Conexão com o Postgres do Supabase (Project Settings > Database > Connection string > Session pooler)
# Troque "postgresql://" por "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Cifra os tokens das lojas no banco. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia segura: sem ela, todas as lojas precisam ser autorizadas de novo.
TOKEN_ENCRYPTION_KEY=

# Chave que os seus sistemas internos enviam no header X-API-Key
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# URL pública desta API (usada no retorno do OAuth do TikTok)
PUBLIC_BASE_URL=https://sua-api.exemplo.com.br

# TikTok Shop Partner Center > App > App Key / App Secret / Service ID
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Segundo app privado, só se houver loja de outro parceiro
TIKTOK2_APP_KEY=
TIKTOK2_APP_SECRET=
TIKTOK2_SERVICE_ID=

# Shopee Open Platform Console > App List > Live Partner_id e Live Partner Key
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# E-mail informado à Shopee ao contestar (recusar) uma devolução
SHOPEE_DISPUTE_EMAIL=

# Mercado Livre Developers > Suas aplicações > Client ID e Client Secret
# (unidade de negócio "Mercado Livre"; permissões "Venda e envios" e "Comunicações" em leitura e escrita)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Idêntica à URI de redirect cadastrada no app (depois do deploy: {PUBLIC_BASE_URL}/auth/mercadolivre/callback)
MERCADOLIVRE_REDIRECT_URI=

# Olist ERP (API v2): Olist > Configurações > Token API
OLIST_API_TOKEN=
# off   = só vincula pedido/NF e registra a condição; a NF é feita à mão no Olist
# draft = a API cria a NF de devolução no Olist; a equipe confere e emite lá (recomendado no início)
# emit  = a API cria e já transmite a NF para a SEFAZ
OLIST_INVOICE_MODE=draft
# Nome EXATO da natureza de entrada cadastrada no Olist. Opções existentes hoje:
#   "Devolução de venda de mercadorias" (série 4)
#   "Devolução de venda de mercadorias de produção própria" (série 1)
#   "Devolução de venda de mercadorias de terceiros" (série 1)
# Use a mesma que a equipe já usa nas devoluções manuais.
OLIST_NATUREZA_OPERACAO=Devolução de venda de mercadorias
# IDs das naturezas (opcional; têm prioridade sobre o nome). Revenda e defeito podem usar o mesmo ID:
# a diferença de estoque é feita pela API, desde que a natureza não lance estoque sozinha.
OLIST_NATUREZA_RESALE_ID=
OLIST_NATUREZA_DEFECT_ID=
# Natureza de devolução pelo CFOP da NF de venda (tem prioridade sobre as acima): 202 = terceiros (1202/2202),
# 201 = produção própria, 411 = com ST; sufixo S = venda feita no Simples (sem destaque). Ex.: 202:123,202S:456
OLIST_RETURN_NATUREZAS=
OLIST_INVOICE_FINALIDADE=4
# Valor do item na NF de devolução: marketplace (valor real da peça no TikTok/Shopee)
# ou sale_invoice (rateio proporcional do desconto da NF de venda)
OLIST_RETURN_VALUE_SOURCE=marketplace
# true  = a API lança o estoque da NF autorizada só para itens revendáveis
# false = a natureza de operação do Olist já lança o estoque sozinha
OLIST_POST_STOCK=true
OLIST_RESALE_DEPOSIT_ID=
# Preencha só se quiser registrar os defeituosos num depósito separado (ex.: "Avariados")
OLIST_DEFECT_DEPOSIT_ID=
# O "lançar estoque" da NF cai sempre no depósito padrão (o de venda). Com os nomes abaixo, o app tira a peça do
# padrão antes de lançar a nota e depois dá entrada no depósito certo, sem a peça ficar à venda nem por segundos.
OLIST_DEFAULT_DEPOSIT_NAME=
OLIST_RESALE_DEPOSIT_NAME=
OLIST_DEFECT_DEPOSIT_NAME=

# Retorno de mercadoria não entregue (pacote volta pela transportadora)
OLIST_IMPORT_UNDELIVERED=true
OLIST_NATUREZA_UNDELIVERED=Retorno de mercadoria nao entregue ao destinatario
OLIST_NATUREZA_UNDELIVERED_ID=
OLIST_UNDELIVERED_FINALIDADE=4
OLIST_UNDELIVERED_SITUACAO=nao_entregue
OLIST_UNDELIVERED_LOOKBACK_DAYS=15

# Custos da devolução (financeiro)
COST_PRODUCT_DEFAULT=40          # custo da peça, perdido quando há defeito
COST_OPERATIONAL_PER_RETURN=4    # receber, conferir e reembalar
COST_SHOPEE_RETURN_SHIPPING=0    # Devolução Fácil: Shopee não cobra o frete na devolução

# Avisos por e-mail (resumo nos horários de ALERT_DIGEST_HOURS e alerta de prazo urgente)
# Gmail: smtp.gmail.com / 587 + "senha de app" (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAILS=
# Quem recebe aviso de falha nas integrações (vazio = ALERT_EMAILS)
ADMIN_EMAILS=
ALERT_DIGEST_HOURS=8,14
ALERT_URGENT_HOURS=12
# Endereço das telas usado nos links dos e-mails (vazio = PUBLIC_BASE_URL)
APP_URL=

# Sincronização periódica (complementa os webhooks, caso algum se perca)
SYNC_INTERVAL_MINUTES=15
SYNC_LOOKBACK_DAYS=30
ENABLE_SCHEDULER=true

TIMEZONE=America/Sao_Paulo

# Câmera da bancada (deploy\agendar-camera-windows.ps1). Vazio = desligada. Tem senha: só no .env
CAMERA_RTSP_URL=
CAMERA_RETENTION_DAYS=30
CAMERA_CLIP_PAD_SECONDS=30
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
